# ===== 出稿模式：one_shot（首句最快，推荐）/ two_stage（并行多路）/ spec（投机竞速）=====
DEBATE_MODE=one_shot

# ===== 主模型 strong（出稿）=====
# 例：经 wawapii 中转的 GLM，首句约 3–5 秒
DEBATE_STRONG_BASE_URL=https://wawapii.com/v1
DEBATE_STRONG_API_KEY=sk-xxxxxxxx
DEBATE_STRONG_MODEL=glm-5.3-flash

# ===== 快模型 fast（结构/策略/事实核查；spec 模式的抢跑路）=====
DEBATE_FAST_BASE_URL=https://wawapii.com/v1
DEBATE_FAST_API_KEY=sk-xxxxxxxx
DEBATE_FAST_MODEL=glm-5.3-flash

# ===== 备用模型 backup（主模型无有效输出时自动降级）=====
DEBATE_BACKUP_BASE_URL=https://api.deepseek.com/v1
DEBATE_BACKUP_API_KEY=sk-xxxxxxxx
DEBATE_BACKUP_MODEL=deepseek-flash
DEBATE_BACKUP_EFFORT=low

# ===== 通用参数 =====
DEBATE_TIMEOUT=120
DEBATE_MAX_TOKENS=4096
DEBATE_PARALLEL=3

# ===== M1 增强：辩论知识库 / 事实核查（on|off）=====
DEBATE_KB=on
DEBATE_FACTCHECK=on

# ===== M3 成本核算（可选；配了才显示估算费用，单位：元/百万 token）=====
# DEBATE_PRICE_IN=
# DEBATE_PRICE_OUT=
# ===== 指标与全自动转写落盘目录（容器内；默认 /data，由宿主卷映射持久化）=====
DEBATE_DATA_DIR=/data
# 宿主映射源（compose 卷 ${DEBATE_DATA_HOST_DIR}:/data；容器重建不丢）
# DEBATE_DATA_HOST_DIR=/var/lib/debate-agent

# ===== M2 语音链路（硅基流动：ASR 识别 + CosyVoice 合成，仅服务端使用）=====
SILICONFLOW_API_KEY=sk-xxxxxxxx
DEBATE_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
DEBATE_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
DEBATE_TTS_SPEAKER=alex
DEBATE_TTS_RATE=+8%

# ===== 访问口令（留空 = 不校验，仅依赖内网/网关隔离）=====
DEBATE_ACCESS_TOKEN=
